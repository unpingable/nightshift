# Nightshift canonical observation-cycle EnvironmentFile.
# Copy to /etc/nightshift/observation-cycle.env and replace every site-owned
# absolute path. The cycle request itself carries the exact recurrence slot and
# complete diagnostic input basis.

NIGHTSHIFT_STORE=/var/lib/nightshift/nightshift.sqlite
NIGHTSHIFT_CYCLE_REQUEST=/etc/nightshift/cycles/current.json
NIGHTSHIFT_NQ_PROGRAM=/usr/local/bin/nq
NIGHTSHIFT_NQ_CONFIG=/etc/nq/nq.toml
# Stable identity, not a path: nq-store-genesis:<NQ sole genesis_id>.
NIGHTSHIFT_NQ_SOURCE_ID=nq-store-genesis:REPLACE_WITH_SITE_GENESIS_ID
NIGHTSHIFT_PRESENT_EVIDENCE_RESOLVER=/usr/local/bin/pulse-support-resolver

# Empty for posture-only cycles. An exact-work request requires all five AG
# coordinates; Nightshift supplies no standing or authorization.
# NIGHTSHIFT_AG_FLAGS=--ag-loopctl /usr/local/bin/ag-loopctl --ag-database /var/lib/ag/campaign.sqlite --ag-observation-resolver /usr/local/bin/ag-observation-resolver --ag-observation-resolver-id nightshift-observation-resolver/v1 --ag-runtime-profile /etc/ag/governed-loop-profile.json
NIGHTSHIFT_AG_FLAGS=
