# Nightshift canonical observation-cycle EnvironmentFile.
# Copy to /etc/nightshift/observation-cycle.env and replace every site-owned
# absolute path. The cycle request itself carries the exact recurrence slot and
# complete diagnostic input basis.

NIGHTSHIFT_STORE=/var/lib/nightshift/nightshift.sqlite
NIGHTSHIFT_CYCLE_REQUEST=/etc/nightshift/cycles/current.json
NIGHTSHIFT_NQ_PROGRAM=/usr/local/bin/nq
NIGHTSHIFT_NQ_CONFIG=/etc/nq/nq.toml
# Stable identity, not a path: nq-store-genesis:<NQ sole genesis_id>.
NIGHTSHIFT_NQ_SOURCE_ID=nq-store-genesis:REPLACE_WITH_SITE_GENESIS_ID
NIGHTSHIFT_PRESENT_EVIDENCE_RESOLVER=/usr/local/bin/pulse-support-resolver

# Empty when no continuity-bearing NQ acquisition is admitted. Sites that
# admit nq.diagnostic_admission_provenance.v2 pin only Standing's public
# verification material and the exact NQ audience. This grants no signing
# capability to Nightshift.
# NIGHTSHIFT_CONTINUITY_FLAGS=--standing-continuity-public-key /etc/nightshift/standing-continuity.pub --standing-continuity-key-id standing-continuity:REPLACE_WITH_KEY_ID --standing-continuity-nq-audience nq:REPLACE_WITH_AUDIENCE
NIGHTSHIFT_CONTINUITY_FLAGS=

# Empty until a subject has an independently qualified origin attester and a
# Nightshift V3 cutover profile. This carries public verification coordinates
# only. Bootstrap is supplied exactly once for the first V3 origin; later
# successor profiles omit it and require admitted history plus Standing.
# NIGHTSHIFT_SUBSTRATE_ORIGIN_FLAGS=--substrate-origin-public-key /etc/nightshift/origin-attester.pub --substrate-origin-profile-id origin-profile:REPLACE --substrate-origin-subject-ref observer:REPLACE --substrate-origin-issuer-id origin-attester:REPLACE --substrate-origin-key-id origin-key:REPLACE --substrate-origin-namespace REPLACE --substrate-origin-bootstrap-coordinate-ref substrate:attester-key:v1:REPLACE
NIGHTSHIFT_SUBSTRATE_ORIGIN_FLAGS=

# Empty for posture-only cycles. An exact-work request requires all five AG
# coordinates; Nightshift supplies no standing or authorization.
# NIGHTSHIFT_AG_FLAGS=--ag-loopctl /usr/local/bin/ag-loopctl --ag-database /var/lib/ag/campaign.sqlite --ag-observation-resolver /usr/local/bin/ag-observation-resolver --ag-observation-resolver-id nightshift-observation-resolver/v1 --ag-runtime-profile /etc/ag/governed-loop-profile.json
NIGHTSHIFT_AG_FLAGS=
