[Unit]
Description=Night Shift watchbill — non-actuating reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/nightshift/watchbill.env

# Substitute via EnvironmentFile. Expansion happens in systemd, not in the
# binary. Braced required values remain one argument; the standalone
# $NIGHTSHIFT_EXTRA_FLAGS value splits into zero or more arguments.
ExecStart=/usr/local/bin/nightshift \
    --store ${NIGHTSHIFT_STORE} \
    --nq-bin ${NIGHTSHIFT_NQ_BIN} \
    --nq-db ${NIGHTSHIFT_NQ_DB} \
    --trigger scheduled \
    $NIGHTSHIFT_EXTRA_FLAGS \
    watchbill run ${NIGHTSHIFT_AGENDA} --finding ${NIGHTSHIFT_FINDING}

# Stdout is the operator-facing surface (packet YAML or
# `scheduled-skip: ...` line). Journald captures it; `journalctl
# -u nightshift-watchbill -n 20` is the operator's review surface.
StandardOutput=journal
StandardError=journal

# Non-actuating daemon — refuse to escalate even if a bug requests
# it. CAP_NET_BIND_SERVICE etc. are not needed; clear them. The
# user/group should own the store path; create them at install time.
User=nightshift
Group=nightshift
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nightshift
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Bounded wall time — Slice 1 expects sub-minute runs against the
# wal-bloat-review pilot. If it ever takes longer, surface it as a
# timeout rather than letting timer firings overlap.
TimeoutStartSec=120s
