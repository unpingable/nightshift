[Unit]
Description=Night Shift watchbill — scheduled timer (user-level)
Documentation=https://github.com/anthropics/scheduler/blob/main/docs/working/decisions/MILESTONE-2026-05-28-first-live-dogfood.md

[Timer]
# Default cadence: every 5 minutes, jittered. The agenda declares
# its own cadence; the timer here is the *invocation* cadence (when
# the daemon wakes up). Idempotency in the daemon (see
# `crates/nightshiftd/src/scheduled.rs`) skips invocations when NQ
# has not advanced its snapshot_generation — so a tight timer is
# safe and produces journal output only when NQ has advanced.
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s
Unit=nightshift-watchbill.service
Persistent=true

[Install]
WantedBy=timers.target
