# Night Shift watchbill — systemd EnvironmentFile.
#
# Copy to /etc/nightshift/watchbill.env (chmod 0640, owned by root,
# readable by the nightshift group) and fill in the values. The
# .service unit substitutes these at exec time.

# Required ---------------------------------------------------------

# SQLite store for run rows, ledger events, bundles, packets, and
# tolerance state. Must be on writable storage owned by the
# nightshift user.
NIGHTSHIFT_STORE=/var/lib/nightshift/nightshift.sqlite

# Live NQ SQLite database (NQ's canonical export source). NS shells
# out to `nq findings export --db $NIGHTSHIFT_NQ_DB ...` for capture
# and reconcile.
NIGHTSHIFT_NQ_DB=/opt/notquery/nq.db

# Agenda YAML — declares workflow family, scope, criticality,
# promotion ceiling, governor binding. See
# `docs/architecture/SCHEMA-agenda.md`.
NIGHTSHIFT_AGENDA=/etc/nightshift/agendas/wal-bloat-review.yaml

# Stable finding key the timer targets: <source>:<detector>:<subject>.
NIGHTSHIFT_FINDING=nq:wal_bloat:labelwatch-host:/var/lib/labelwatch.sqlite

# Optional --------------------------------------------------------
#
# Extra flags appended to the global flag list. Quote values
# containing spaces; clear it (empty string) when not needed. See
# `nightshift --help`. Typical contents for the action-authorized
# path (Tier-2 horizon, governed by Governor):
#
#   NIGHTSHIFT_EXTRA_FLAGS=--horizon-policy /etc/nightshift/horizon.json \
#                          --governor-socket /run/governor/socket \
#                          --nq-liveness /opt/notquery/liveness.json
#
# v1 Tier-1 default is no extra flags (observe/advise only against
# the NQ source + liveness gate).
NIGHTSHIFT_EXTRA_FLAGS=
