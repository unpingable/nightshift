{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nightshift.operational-observation-lineage/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lineage_id",
    "monitor_result_head",
    "nq_result_head",
    "monitor_custody",
    "nq_custody",
    "nq_profile_id",
    "nq_input_id",
    "subject",
    "subject_identity_digest",
    "producer",
    "producer_identity_digest",
    "acquisition_outcome",
    "acquisition_started_at",
    "acquisition_ended_at",
    "producer_observed_at",
    "receiver_custody_at",
    "nq_qualified_at",
    "nightshift_admitted_at",
    "epoch",
    "sequence",
    "predecessor_observation_digest",
    "payload_schema",
    "claim_support",
    "cannot_testify",
    "refusals",
    "contradictions",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "nightshift.operational-observation-lineage/v1"
    },
    "lineage_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "monitor_result_head": {
      "const": "b2d52fe34f146774cbf5601819982c267c7fb082"
    },
    "nq_result_head": {
      "const": "39b9f84f2f70955dd12e5cbfe798c740f9e52854"
    },
    "monitor_custody": {
      "$ref": "#/$defs/custody"
    },
    "nq_custody": {
      "$ref": "#/$defs/custody"
    },
    "nq_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "nq_input_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "subject_identity_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "producer_identity_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "acquisition_outcome": {
      "enum": [
        "observation_produced",
        "no_response",
        "command_failed",
        "producer_unavailable",
        "receiver_unavailable",
        "malformed_input",
        "refused"
      ]
    },
    "acquisition_started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "acquisition_ended_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "producer_observed_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "receiver_custody_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nq_qualified_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nightshift_admitted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "epoch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "predecessor_observation_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_schema": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim_support": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim_support"
      }
    },
    "cannot_testify": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/cannot_testify"
      }
    },
    "refusals": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/refusal"
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/contradiction"
      }
    },
    "nonclaims": {
      "const": [
        "lineage is temporal custody, not claim qualification",
        "currentness is not standing, authorization, or permission to act",
        "producer class does not establish evidentiary precedence",
        "re-observation may acquire testimony but cannot remediate a target"
      ]
    }
  },
  "$defs": {
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_bytes_sha256",
        "raw_bytes_length",
        "semantic_digest"
      ],
      "properties": {
        "raw_bytes_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "raw_bytes_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "semantic_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "namespace",
        "basis_contract",
        "stable_basis"
      ],
      "properties": {
        "kind": {
          "enum": [
            "host",
            "service_instance",
            "deployment_release",
            "repository_revision",
            "scheduler_job",
            "ecad_design_revision",
            "toolchain",
            "pdk",
            "license_entitlement",
            "worker",
            "artifact_set",
            "stage_occurrence"
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "basis_contract": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "stable_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis_type"
          ],
          "properties": {
            "basis_type": {
              "enum": [
                "host",
                "service_instance",
                "deployment_release",
                "repository_revision",
                "scheduler_job",
                "ecad_design_revision",
                "toolchain",
                "pdk",
                "license_entitlement",
                "worker",
                "artifact_set",
                "stage_occurrence"
              ]
            },
            "machine_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "service_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "instance_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "deployment_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "release_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "repository_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "revision_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "scheduler_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "job_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "design_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "toolchain_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "pdk_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "entitlement_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "worker_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "artifact_set_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "run_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "stage_occurrence_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "minProperties": 2,
          "maxProperties": 3
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "collector_id",
        "key_algorithm",
        "public_key_hex",
        "public_key_digest",
        "producer_class"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "collector_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "key_algorithm": {
          "const": "ed25519"
        },
        "public_key_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "public_key_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "producer_class": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        }
      }
    },
    "claim_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "proposition",
        "value_digest",
        "monitor_record_digest"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "proposition": {
          "type": "string",
          "minLength": 1
        },
        "value_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "monitor_record_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "cannot_testify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "reason"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "exact_basis_digest",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "exact_basis_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_identity_digest",
        "claim_id",
        "first_input_id",
        "first_value_digest",
        "second_input_id",
        "second_value_digest"
      ],
      "properties": {
        "subject_identity_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "first_input_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "first_value_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "second_input_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "second_value_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
